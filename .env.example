# 复制本文件为 .env，然后填入真实值
# .env 已被 .gitignore 排除，永远不会进入 Git
# 这个模板文件本身可以提交，用来说明"需要哪些配置"

DEEPSEEK_API_KEY=sk-在这里填你的真实Key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 调用方鉴权：客户端需带请求头 X-API-Key
# 多个 Key 用英文逗号分隔；留空 = 开发模式（不校验，但仍限流）
API_KEYS=af_change_me

# 限流：窗口内最多几次 / 窗口多少秒
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW=60
